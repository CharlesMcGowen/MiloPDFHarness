# Copy to .env for local use. Never commit .env.
MILO_DATABASE_URL=sqlite:///./var/milo.sqlite3
MILO_INPUT_ROOT=./var/input
MILO_OUTPUT_ROOT=./var/output
MILO_MAX_UPLOAD_MB=50
MILO_QUALITY_THRESHOLD=0.50
MILO_MAX_REPROCESS_ATTEMPTS=3

# Optional OpenAI-compatible local quality judge. Blank means offline heuristics only.
MILO_LLM_BASE_URL=
MILO_LLM_MODEL=
MILO_LLM_API_KEY=

# Optional API bearer token. Required by the CLI when binding beyond loopback.
MILO_API_TOKEN=
